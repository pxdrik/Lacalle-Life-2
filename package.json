{
  "name": "lacalle-life-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "capture": "node scripts/capture.mjs",
    "render": "remotion render Ad out/lacalle-life-9x16.mp4",
    "render:wide": "remotion render AdWide out/lacalle-life-16x9.mp4",
    "score": "node scripts/score.mjs",
    "audio": "node scripts/audio/compose.mjs",
    "audio:check": "node scripts/audio/check.mjs",
    "render:mobile": "remotion render Ad out/lacalle-life-9x16-mobile.mp4 --props=props/mobile.json",
    "render:wide:mobile": "remotion render AdWide out/lacalle-life-16x9-mobile.mp4 --props=props/mobile.json",
    "audio:selftest": "node scripts/audio/selftest.mjs",
    "audio:music": "node scripts/audio/music.mjs",
    "render:musica": "remotion render Ad out/lacalle-life-9x16-musica.mp4 --props=props/cinematic-musica.json",
    "render:wide:musica": "remotion render AdWide out/lacalle-life-16x9-musica.mp4 --props=props/cinematic-musica.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.526",
    "@remotion/fonts": "4.0.526",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/react": "^19.2.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.0"
  }
}
